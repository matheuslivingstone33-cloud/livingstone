generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) usada pelo prisma migrate. Localmente, igual a DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ANALISTA
  AUDITOR
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  // Configurações da instituição: layout CNAB, chave Pix, limites de PLD, crédito e cobrança
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  users     User[]
  restricted RestrictedEntry[]
  audits    AuditLog[]
  reconciliations Reconciliation[]
  credits   CreditAnalysis[]
  legacies  LegacyAnalysis[]
  debts     Debt[]
  pldBatches PldBatch[]
  pldCases   PldCase[]
  apiKeys    ApiKey[]
  apiRequests ApiRequest[]
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(ANALISTA)
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  active       Boolean      @default(true)
  // Bloqueio contra força bruta
  failedLogins Int          @default(0)
  lockedUntil  DateTime?
  // Incrementado para derrubar todas as sessões do usuário (troca de senha, desativação, mudança de perfil)
  sessionVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  audits       AuditLog[]
  apiKeys      ApiKey[]
}

// Listas restritivas e de PEP importadas pela instituição (CSNU, OFAC, CGU/PEP, listas internas)
model RestrictedEntry {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  source    String // CSNU | OFAC | PEP | INTERNA
  name      String
  nameKey   String // nome normalizado para comparação
  document  String? // apenas dígitos (pode ser parcial, ex.: CPF mascarado da CGU)
  reason    String?
  importedAt DateTime    @default(now())

  @@index([orgId, document])
  @@index([orgId, nameKey])
}

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  ip        String?
  // Encadeamento: cada registro guarda o hash do anterior, então alterar ou apagar um quebra a corrente
  prevHash  String?
  hash      String?
  // Sequência por organização (registros v2); nula no legado anterior a ela
  seq       Int?
  createdAt DateTime     @default(now())

  @@unique([orgId, seq])
  @@index([orgId, createdAt])
  @@index([orgId, action, createdAt])
}

model Reconciliation {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  name          String
  bankFileName  String
  bankFormat    String
  expectedFileName String
  totalExpected Decimal      @db.Decimal(14, 2)
  totalReceived Decimal      @db.Decimal(14, 2)
  matched       Int
  divergent     Int
  missing       Int
  unexpected    Int
  totalExcess   Decimal      @default(0) @db.Decimal(14, 2)
  options       Json         @default("{}") // regras usadas: tolerâncias e casamento por valor+data
  createdAt     DateTime     @default(now())
  items         ReconciliationItem[]
}

model ReconciliationItem {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reference        String
  payer            String?
  expectedAmount   Decimal?       @db.Decimal(14, 2)
  receivedAmount   Decimal?       @db.Decimal(14, 2)
  paidAt           DateTime?
  status           String // CONCILIADO | DIVERGENTE | PENDENTE | NAO_ESPERADO
  rule             String? // REFERENCIA | REFERENCIA_DV | VALOR_DATA (nulo em conciliações antigas)
  dueAt            DateTime?
  excess           Decimal?       @db.Decimal(14, 2)
  note             String?
}

model CreditAnalysis {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  applicant   String
  document    String?
  requested   Decimal      @db.Decimal(14, 2)
  score       Int
  decision    String // APROVAR | ANALISAR | RECUSAR
  extracted   Json
  flags       Json
  opinion     String
  opinionBase String? // parecer determinístico (o exibido pode ser o da IA)
  aiStatus    String? // usada | rejeitada | falhou | desligada
  aiProvider  String
  fileNames   String[]
  createdAt   DateTime     @default(now())
}

model LegacyAnalysis {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  fileName    String
  language    String
  target      String
  linesOfCode Int
  summary     String
  rules       Json
  modernCode  String
  aiStatus    String? // usada | rejeitada | falhou | desligada
  aiProvider  String
  createdAt   DateTime     @default(now())
}

// Cobrança e renegociação
model Debt {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  contract     String
  debtor       String
  document     String
  phone        String?
  email        String?
  product      String?
  principal    Decimal      @db.Decimal(14, 2)
  dueDate      DateTime
  status       String       @default("EM_ABERTO") // EM_ABERTO | NEGOCIANDO | ACORDO | QUITADO
  importedFrom String?
  createdAt    DateTime     @default(now())
  agreements   Agreement[]

  @@unique([orgId, contract])
}

model Agreement {
  id            String    @id @default(cuid())
  debtId        String
  debt          Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  token         String    @unique
  daysLate      Int
  updatedDebt   Decimal   @db.Decimal(14, 2)
  discountPct   Decimal   @db.Decimal(5, 2)
  total         Decimal   @db.Decimal(14, 2)
  installments  Int
  installment   Decimal   @db.Decimal(14, 2)
  options       Json
  message       String
  messageBase   String? // mensagem determinística (a exibida pode ser a da IA conferida)
  aiStatus      String? // usada | rejeitada | falhou | desligada
  aiProvider    String
  status        String    @default("PROPOSTO") // PROPOSTO | ACEITO | PAGO | CANCELADO
  acceptedAt    DateTime?
  paidAt        DateTime?
  paidAmount    Decimal?  @db.Decimal(14, 2)
  expiresAt     DateTime
  payments      Payment[]
  createdAt     DateTime  @default(now())
}

// Prevenção à lavagem de dinheiro (PLD)
model PldBatch {
  id           String           @id @default(cuid())
  orgId        String
  org          Organization     @relation(fields: [orgId], references: [id])
  fileName     String
  transactions Int
  clients      Int
  alerts       Int
  periodStart  DateTime
  periodEnd    DateTime
  status       String           @default("CONCLUIDO") // PROCESSANDO | CONCLUIDO | FALHOU
  error        String?
  createdAt    DateTime         @default(now())
  txs          PldTransaction[]
  cases        PldCase[]

  @@index([orgId, status])
}

model PldTransaction {
  id           String   @id @default(cuid())
  batchId      String
  batch        PldBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date         DateTime
  clientDoc    String
  clientName   String
  type         String
  direction    String // C (crédito) | D (débito)
  amount       Decimal  @db.Decimal(14, 2)
  counterparty String?
  counterDoc   String?

  @@index([batchId, clientDoc])
}

model PldCase {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  batchId       String
  batch         PldBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  clientDoc     String
  clientName    String
  declaredIncome Decimal?    @db.Decimal(14, 2)
  pep           Boolean      @default(false)
  score         Int
  risk          String // ALTO | MEDIO | BAIXO
  alerts        Json
  totalIn       Decimal      @db.Decimal(14, 2)
  totalOut      Decimal      @db.Decimal(14, 2)
  status        String       @default("EM_ANALISE") // EM_ANALISE | ARQUIVADO | COMUNICADO
  mandatory     Boolean      @default(false) // comunicação obrigatória (COE), ex.: espécie >= R$ 50 mil
  dueAt         DateTime
  dossier       String?
  dossierAi     String?
  dossierBase   String? // dossiê determinístico
  dossierAiText String? // versão da IA, só quando aprovada na conferência
  dossierAiAt   DateTime? // última tentativa com IA (janela de 24h)
  decision      String?
  protocol      String?
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([orgId, status])
}

// Pagamentos recebidos (manual ou webhook Pix). endToEndId único garante que o mesmo Pix não seja baixado duas vezes.
model Payment {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 2)
  paidAt      DateTime
  source      String // MANUAL | PIX_WEBHOOK
  endToEndId  String?   @unique
  txid        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
}

// Chaves da API pública. Pertencem à instituição: desativar quem criou não revoga a chave.
model ApiKey {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  prefix      String       @unique
  hash        String       @unique // sha256 do segredo; o segredo em si nunca é guardado
  scopes      String[]
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  requests    ApiRequest[]

  @@index([orgId])
}

// Registro das chamadas da API: base do limite de requisições e da idempotência
model ApiRequest {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  apiKeyId       String
  apiKey         ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  method         String
  path           String
  status         Int
  idempotencyKey String?
  fingerprint    String?
  resourceType   String?
  resourceId     String?
  responseJson   Json?
  createdAt      DateTime     @default(now())

  @@unique([apiKeyId, idempotencyKey])
  @@index([apiKeyId, createdAt])
}
