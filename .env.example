# ---------- Obrigatórias ----------
# Conexão usada pela aplicação. Na Vercel, use o pooler do provedor com ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/finops_ai"
# Conexão direta (sem pooler), usada pelo prisma migrate. Localmente, igual a DATABASE_URL.
DIRECT_URL="postgresql://postgres:SENHA@localhost:5432/finops_ai"
# Assinatura da sessão: mínimo 32 caracteres aleatórios
AUTH_SECRET="gere-um-valor-aleatorio-longo"
# URL pública deste ambiente (uma por ambiente: produção e preview)
APP_URL="https://finops.suaempresa.com.br"
# Protege os crons /api/cron/limpeza e /api/cron/regua (a Vercel envia Authorization: Bearer CRON_SECRET). Sem ele, a rota responde 401.
CRON_SECRET=""

# ---------- Opcionais ----------
# Segredo próprio (mínimo 32 caracteres) para assinar recibos de integridade da auditoria.
# Sem ele, o segredo é derivado do AUTH_SECRET (HKDF). Trocar qualquer um invalida recibos já emitidos.
# AUDIT_RECEIPT_SECRET=""
# IA: sem chave, os módulos seguem funcionando sem a parte de IA
ANTHROPIC_API_KEY=""
# Modelo por tarefa (opcional; o padrão já vem escolhido). Só vale um id no formato claude-...
# AI_MODEL_COBRANCA="claude-haiku-5-5"
# AI_MODEL_PLD="claude-haiku-5-5"
# AI_MODEL_CREDITO="claude-haiku-5-5"
# AI_MODEL_LEGADO="claude-sonnet-5-5"
# AI_MODEL_RESUMO="claude-haiku-5-5"

PIX_KEY=""
PIX_MERCHANT=""
PIX_CITY=""
# Webhook Pix: o segredo vai no header x-webhook-secret. "1" aceita também ?secret= na URL
# (só para PSP sem header customizado; o segredo aparece em logs). Desligado por padrão.
# PIX_WEBHOOK_ALLOW_QUERY_SECRET="1"

# Régua de cobrança (WhatsApp pela Evolution API). Sem os três, a régua não envia nada ("Envio desligado").
# A URL precisa ser https. A chave nunca aparece em logs nem na auditoria.
# EVOLUTION_API_URL="https://evolution.suaempresa.com.br"
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCE="cobranca"
