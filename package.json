{
  "name": "finops-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/modulos.test.mts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "demo:files": "node scripts/gerar-demo.mjs",
    "setup": "prisma migrate dev --name init && npm run db:seed && npm run demo:files",
    "db:demo": "tsx prisma/seed-demo.ts",
    "video:studio": "remotion studio video/index.ts",
    "video:render": "remotion render video/index.ts LivingstoneHero out/livingstone-hero.mp4 --codec=h264 --image-format=png --crf=12 --pixel-format=yuv420p && remotion still video/index.ts LivingstoneHero public/video/livingstone-hero-poster.png --frame=560 --image-format=png && node scripts/publicar-video.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "15.5.27",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "remotion": "4.0.536",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.5": true
  }
}
